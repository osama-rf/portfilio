---
import "../styles/global.css";
import ThemeLangToggle from "@components/ThemeLangToggle.astro";
import { getPaymentLang, t } from "@lib/payment-i18n";

interface Props {
  title: string;
}
const { title } = Astro.props;

const lang = getPaymentLang(Astro.url, Astro.cookies.get("lang")?.value);
const content = t(lang);
---

<!doctype html>
<html lang={lang} dir={content.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {content.admin}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "dark" || saved === "light" ? saved : "light";
        document.documentElement.classList.add(theme);
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white font-sans text-slate-900 dark:bg-black dark:text-white">
    <header class="border-b border-slate-200 dark:border-white/10">
      <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-5">
        <a href="/admin" class="font-semibold">{content.admin}</a>
        <div class="flex items-center gap-3">
          <ThemeLangToggle lang={lang} />
          <form method="POST" action="/api/admin/logout">
            <button
              type="submit"
              class="text-sm text-slate-500 hover:text-slate-900 dark:text-white/60 dark:hover:text-white"
            >
              {content.signOut}
            </button>
          </form>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-6 sm:px-5 sm:py-8">
      <slot />
    </main>
  </body>
</html>
