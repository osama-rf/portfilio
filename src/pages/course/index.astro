---
export const prerender = true;
import "../../styles/global.css";
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/500.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import "@fontsource/ibm-plex-sans-arabic/700.css";
import { lessons } from "../../data/course-lessons";

const pageURL = "https://osama-lab.com/course";
const title = "دروس دورة بناء تطبيقات حقيقية باستخدام الذكاء الاصطناعي";
const description = "مرجع المدرب — 5 دروس، كل درس يبني تطبيقًا حقيقيًا كاملًا باستخدام Replit والذكاء الاصطناعي.";
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Osama AlRefay" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="canonical" href={pageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen bg-[#fafbfc] font-sans text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
        <a href="/" class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900">
          ← osama-lab.com
        </a>
        <p class="text-sm font-medium text-slate-400">مرجع المدرب</p>
      </div>
    </header>

    <section class="border-b border-slate-200 bg-white px-5 py-12 sm:py-16">
      <div class="mx-auto max-w-3xl">
        <span class="mb-4 inline-block rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-600">
          5 دروس · كل درس يبني تطبيقًا حقيقيًا
        </span>
        <h1 class="text-2xl leading-snug font-bold sm:text-4xl">
          دورة بناء تطبيقات حقيقية باستخدام الذكاء الاصطناعي
        </h1>
        <p class="mt-2 text-base text-slate-500 sm:text-lg">من الفكرة إلى App Store وGoogle Play</p>
        <p class="mt-4 max-w-2xl leading-relaxed text-slate-500">
          كل درس مبني حول تطبيق حقيقي كامل — تبدأ الفكرة، تبني الميزة، وتشرح المفهوم من خلال
          تطبيق يشتغل فعليًا أمام المشاركين.
        </p>
      </div>
    </section>

    <main class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
      <div class="space-y-4">
        {lessons.map((lesson) => (
          <a
            href={`/course/${lesson.slug}`}
            class="group block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-sm sm:p-6"
          >
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <span class="rounded-md bg-indigo-600 px-2.5 py-1 text-xs font-bold text-white">
                    درس {lesson.number}
                  </span>
                  {lesson.appName && (
                    <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
                      تطبيق {lesson.appName}
                    </span>
                  )}
                  <span class="text-xs text-slate-400">{lesson.duration}</span>
                </div>
                <h2 class="text-lg font-bold text-slate-900 sm:text-xl">{lesson.title}</h2>
                <p class="mt-1 text-sm text-slate-500">{lesson.subtitle}</p>
              </div>
              <svg
                class="mt-1 h-5 w-5 shrink-0 text-slate-300 transition group-hover:translate-x-[-4px] group-hover:text-indigo-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </main>

    <footer class="border-t border-slate-200 bg-white px-5 py-8 text-center text-sm text-slate-400">
      <p>© {new Date().getFullYear()} osama-lab.com — أسامة يحيى عبده رفاعي</p>
    </footer>
  </body>
</html>
