---
import "../../styles/global.css";
import { supabaseAdmin } from "@lib/supabase-admin";
import ThemeLangToggle from "@components/ThemeLangToggle.astro";
import { getPaymentLang, t } from "@lib/payment-i18n";

const { id } = Astro.params;
const lang = getPaymentLang(Astro.url, Astro.cookies.get("lang")?.value);
const content = t(lang);

const { data: link } = supabaseAdmin
  ? await supabaseAdmin
      .from("payment_links")
      .select("id, title, description, amount, currency, status, moyasar_enabled, tamara_enabled")
      .eq("id", id)
      .single()
  : { data: null };

const moyasarPublicKey = import.meta.env.MOYASAR_PUBLIC_KEY;
const gatewayParam = Astro.url.searchParams.get("gateway");
const statusParam = Astro.url.searchParams.get("status");
const moyasarPaymentId = Astro.url.searchParams.get("id");
const moyasarLocale = lang === "ar" ? "ar" : "en";
---

<!doctype html>
<html lang={lang} dir={content.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{link ? link.title : "Payment"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "dark" || saved === "light" ? saved : "light";
        document.documentElement.classList.add(theme);
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style>
      .mysr-form .mysr-form-footer {
        display: none !important;
      }
      .mysr-form-button {
        background-color: #0b0a0a !important;
        color: #ffffff !important;
      }
    </style>
  </head>
  <body class="min-h-screen bg-white font-sans text-[#0B0A0A] dark:bg-black dark:text-white">
    <div class="mx-auto flex min-h-screen max-w-[428px] flex-col px-5 pt-4">
      <div class="mb-2 flex justify-end">
        <ThemeLangToggle lang={lang} />
      </div>

      {!link && (
        <div class="mt-10 rounded-lg border border-[#EEF0F2] p-6 text-center dark:border-white/10">
          <h1 class="text-lg font-semibold text-red-500 dark:text-red-400">{content.pay.notFound}</h1>
          <p class="mt-2 text-sm text-[#808080]">{content.pay.notFoundHint}</p>
        </div>
      )}

      {link && (
        <div
          id="pay-root"
          data-link-id={link.id}
          data-amount={link.amount}
          data-currency={link.currency}
          data-moyasar-enabled={link.moyasar_enabled}
          data-tamara-enabled={link.tamara_enabled}
        >
          {link.status === "paid" && (
            <div class="mt-10 rounded-lg border border-[#EEF0F2] p-6 text-center dark:border-white/10">
              <h2 class="text-lg font-semibold text-green-600 dark:text-green-400">{content.pay.alreadyPaid}</h2>
              <p class="mt-2 text-sm text-[#808080]">{content.pay.alreadyPaidHint}</p>
            </div>
          )}

          {(link.status === "cancelled" || link.status === "expired") && (
            <div class="mt-10 rounded-lg border border-[#EEF0F2] p-6 text-center dark:border-white/10">
              <h2 class="text-lg font-semibold text-red-600 dark:text-red-400">{content.pay.inactive}</h2>
              <p class="mt-2 text-sm text-[#808080]">{content.pay.inactiveHint}</p>
            </div>
          )}

          {link.status === "pending" && (
            <div id="pay-form-area" class="pb-10">
              <div id="verifying-box" class="hidden py-16 text-center">
                <div class="mysr-spinner mx-auto mb-4 h-8 w-8 animate-spin rounded-full border-2 border-[#0B0A0A]/20 border-t-[#0B0A0A] dark:border-white/20 dark:border-t-white"></div>
                <p class="verifying-text text-sm text-[#808080]">{content.pay.verifying}</p>
              </div>

              <div id="success-box" class="hidden py-16 text-center">
                <h2 class="mb-2 text-lg font-semibold text-green-600 dark:text-green-400">
                  {content.pay.success}
                </h2>
                <p class="text-sm text-[#808080]">{content.pay.successHint}</p>
              </div>

              <div id="failed-box" class="hidden py-16 text-center">
                <h2 class="mb-2 text-lg font-semibold text-red-600 dark:text-red-400">{content.pay.failed}</h2>
                <p class="failed-text text-sm text-[#808080]">{content.pay.failedHint}</p>
              </div>

              <div id="checkout-area">
                <div class="mt-4 mb-6">
                  <h1 class="text-lg font-semibold">{link.title}</h1>
                  {link.description && (
                    <p class="mt-1 text-sm text-[#808080]">{link.description}</p>
                  )}
                </div>

                <div class="mb-6">
                  <h2 class="mb-3 text-[20px] font-semibold">
                    {lang === "ar" ? "طريقة الدفع" : "Payment method"}
                  </h2>

                  {link.moyasar_enabled && (
                    <div
                      id="select-apple-pay"
                      class="method-row cursor-pointer border-b border-[#EEF0F2] py-4 dark:border-white/10"
                    >
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <img src="/apple-pay-logo.svg" alt="Apple Pay" width="32" height="19" />
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="text-[18px]">Apple Pay</span>
                          <span class="method-dot flex h-4 w-4 items-center justify-center rounded-full border border-[#0B0A0A] dark:border-white">
                            <span class="method-dot-inner hidden h-1.5 w-1.5 rounded-full bg-[#0B0A0A] dark:bg-white"></span>
                          </span>
                        </div>
                      </div>
                    </div>
                  )}

                  {link.moyasar_enabled && (
                    <div
                      id="select-credit-card"
                      class="method-row cursor-pointer border-b border-[#EEF0F2] py-4 dark:border-white/10"
                    >
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1">
                          <img src="/mastercard-logo.svg" alt="Mastercard" width="28" height="22" />
                          <img src="/visa-logo.svg" alt="Visa" width="32" height="12" />
                          <img src="/mada-logo.svg" alt="Mada" width="32" height="37" />
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="text-[18px]">{lang === "ar" ? "البطاقة الإئتمانية" : "Credit card"}</span>
                          <span class="method-dot flex h-4 w-4 items-center justify-center rounded-full border border-[#0B0A0A] dark:border-white">
                            <span class="method-dot-inner hidden h-1.5 w-1.5 rounded-full bg-[#0B0A0A] dark:bg-white"></span>
                          </span>
                        </div>
                      </div>
                    </div>
                  )}

                  {link.tamara_enabled && (
                    <div
                      id="select-tamara"
                      class="method-row cursor-pointer border-b border-[#EEF0F2] py-4 dark:border-white/10"
                    >
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <img src="/tamara-logo.svg" alt="Tamara" width="60" height="24" />
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="text-[18px]">{lang === "ar" ? "تمارا" : "Tamara"}</span>
                          <span class="method-dot flex h-4 w-4 items-center justify-center rounded-full border border-[#0B0A0A] dark:border-white">
                            <span class="method-dot-inner hidden h-1.5 w-1.5 rounded-full bg-[#0B0A0A] dark:bg-white"></span>
                          </span>
                        </div>
                      </div>
                    </div>
                  )}
                </div>

                <div class="mb-6">
                  <h2 class="mb-2 text-[20px] font-semibold">
                    {lang === "ar" ? "ملخص الطلب" : "Order summary"}
                  </h2>
                  <div class="flex items-center justify-between border-b border-[#EEF0F2] pb-4 dark:border-white/10">
                    <span class="text-xs">{lang === "ar" ? "الإجمالي" : "Total"}</span>
                    <div class="flex items-center gap-1">
                      <span class="text-sm">{Number(link.amount).toFixed(2)}</span>
                      <img src="/riyal.svg" alt="ريال" width="14" height="14" />
                    </div>
                  </div>
                  <div class="mt-3 flex items-center justify-between">
                    <span class="text-sm font-bold">
                      {lang === "ar" ? "الإجمالي النهائي" : "Final total"}
                    </span>
                    <div class="flex items-center gap-1">
                      <span class="text-base font-bold">{Number(link.amount).toFixed(2)}</span>
                      <img src="/riyal.svg" alt="ريال" width="16" height="16" />
                    </div>
                  </div>
                </div>

                <div id="moyasar-area" class="mb-6 hidden">
                  <div class="mysr-form"></div>
                </div>

                <button
                  id="pay-cta"
                  type="button"
                  disabled
                  style="background-color: #122023; color: #ffffff; text-align: center;"
                  class="hidden w-full rounded-lg py-3 text-center text-[18px] font-medium transition disabled:opacity-40"
                >
                  {lang === "ar" ? "إتمام الدفع" : "Complete payment"}
                </button>
              </div>
            </div>
          )}
        </div>
      )}
    </div>

    <script
      define:vars={{
        moyasarPublicKey,
        gatewayParam,
        statusParam,
        moyasarPaymentId,
        moyasarLocale,
        redirectingTamaraMsg: content.pay.redirectingTamara,
        confirmingTamaraMsg: content.pay.confirmingTamara,
        stillProcessingMsg: content.pay.stillProcessing,
      }}
    >
      const root = document.getElementById("pay-root");
      if (root) {
        const linkId = root.dataset.linkId;
        const amount = parseFloat(root.dataset.amount);
        const currency = root.dataset.currency;

        const checkoutArea = document.getElementById("checkout-area");
        const moyasarArea = document.getElementById("moyasar-area");
        const verifyingBox = document.getElementById("verifying-box");
        const successBox = document.getElementById("success-box");
        const failedBox = document.getElementById("failed-box");
        const payCta = document.getElementById("pay-cta");

        function showOnly(el) {
          [checkoutArea, verifyingBox, successBox, failedBox].forEach((e) => {
            if (!e) return;
            e.classList.toggle("hidden", e !== el);
          });
        }

        let selectedMethod = null;
        let moyasarLoaded = false;

        function selectMethod(method) {
          selectedMethod = method;
          document.querySelectorAll(".method-row").forEach((row) => {
            const dot = row.querySelector(".method-dot-inner");
            dot.classList.toggle("hidden", row.id !== `select-${method}`);
          });
          const isMoyasar = method === "apple-pay" || method === "credit-card";
          moyasarArea.classList.toggle("hidden", !isMoyasar);
          payCta.classList.toggle("hidden", isMoyasar);
          payCta.disabled = false;

          if (isMoyasar) {
            initMoyasar(method);
          }
        }

        function loadMoyasarAssets() {
          if (moyasarLoaded) return Promise.resolve();
          return new Promise((resolve) => {
            const script = document.createElement("script");
            script.src = "https://cdn.moyasar.com/mpf/1.13.0/moyasar.js";
            script.onload = () => {
              moyasarLoaded = true;
              resolve();
            };
            document.head.appendChild(script);

            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = "https://cdn.moyasar.com/mpf/1.13.0/moyasar.css";
            document.head.appendChild(link);
          });
        }

        async function initMoyasar(method) {
          await loadMoyasarAssets();
          document.querySelector(".mysr-form").innerHTML = "";
          // @ts-ignore
          Moyasar.init({
            element: ".mysr-form",
            amount: Math.round(amount * 100),
            currency,
            description: root.querySelector("h1")?.textContent || "Payment",
            publishable_api_key: moyasarPublicKey,
            callback_url: `${window.location.origin}/pay/${linkId}?gateway=moyasar`,
            methods: method === "apple-pay" ? ["applepay"] : ["creditcard"],
            apple_pay: {
              country: "SA",
              label: "osama-lab.com",
              validate_merchant_url: "https://api.moyasar.com/v1/applepay/initiate",
            },
            language: moyasarLocale,
          });
        }

        document.getElementById("select-apple-pay")?.addEventListener("click", () => selectMethod("apple-pay"));
        document.getElementById("select-credit-card")?.addEventListener("click", () => selectMethod("credit-card"));
        document.getElementById("select-tamara")?.addEventListener("click", () => selectMethod("tamara"));

        // If Tamara is the only enabled gateway, skip the selector entirely.
        const moyasarEnabled = root.dataset.moyasarEnabled === "true";
        const tamaraEnabled = root.dataset.tamaraEnabled === "true";
        if (!moyasarEnabled && tamaraEnabled) {
          selectMethod("tamara");
        }

        payCta.addEventListener("click", async () => {
          if (selectedMethod === "tamara") {
            showOnly(verifyingBox);
            verifyingBox.querySelector(".verifying-text").textContent = redirectingTamaraMsg;
            try {
              const res = await fetch("/api/pay/tamara-checkout", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ linkId }),
              });
              const data = await res.json();
              if (res.ok && data.redirect_url) {
                window.location.href = data.redirect_url;
              } else {
                showOnly(failedBox);
              }
            } catch {
              showOnly(failedBox);
            }
          }
          // For apple-pay / credit-card, the Moyasar widget's own button handles submission.
        });

        // Handle return redirects from Moyasar / Tamara
        (async () => {
          if (moyasarPaymentId && !gatewayParam) {
            showOnly(verifyingBox);
            try {
              const res = await fetch(`/api/pay/verify-moyasar?id=${moyasarPaymentId}&link=${linkId}`);
              const data = await res.json();
              showOnly(data.verified ? successBox : failedBox);
            } catch {
              showOnly(failedBox);
            }
          } else if (gatewayParam === "tamara") {
            if (statusParam === "success") {
              showOnly(verifyingBox);
              verifyingBox.querySelector(".verifying-text").textContent = confirmingTamaraMsg;
              for (let i = 0; i < 10; i++) {
                await new Promise((r) => setTimeout(r, 1500));
                const res = await fetch(`/api/pay/status?link=${linkId}`);
                const data = await res.json().catch(() => ({}));
                if (data.status === "paid") {
                  showOnly(successBox);
                  return;
                }
              }
              showOnly(failedBox);
              failedBox.querySelector(".failed-text").textContent = stillProcessingMsg;
            } else {
              showOnly(failedBox);
            }
          }
        })();
      }
    </script>
  </body>
</html>
