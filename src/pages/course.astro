            <p class="mb-1 text-xs font-semibold text-white/40">طبيعة الدورة</p>
            <p class="text-sm text-white/80">
              دورة عملية تطبيقية، يتم خلالها بناء تطبيق حقيقي من الصفر باستخدام Replit وأدوات
              الذكاء الاصطناعي، ثم ربطه بالخدمات الأساسية وتجهيزه للنشر على متاجر التطبيقات.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── PROJECT ───────────────────────────────────────────── -->
    <section class="border-b border-white/[0.06] bg-white/[0.02] px-5 py-10 sm:py-12">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-2 text-lg font-bold sm:text-xl">المشروع التطبيقي</h2>
        <p class="mb-5 leading-relaxed text-white/50">
          سيتم خلال الدورة بناء <span class="font-semibold text-white">تطبيق لحجز الخدمات</span>.
          يتيح التطبيق للمستخدم:
        </p>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {bookingFeatures.map((feature) => (
            <div class="flex items-center gap-2 rounded-md border border-white/[0.06] bg-black/30 px-3 py-2">
              <svg class="h-4 w-4 shrink-0 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-sm text-white/80">{feature}</span>
            </div>
          ))}
        </div>
        <p class="mt-5 text-sm leading-relaxed text-white/40">
          وسيتم استخدام المشروع لشرح المفاهيم التي يمكن تطبيقها لاحقًا على أنواع مختلفة من
          التطبيقات.
        </p>
      </div>
    </section>

    <!-- ─── DAY TABS ──────────────────────────────────────────── -->
    <nav class="sticky top-[57px] z-40 border-b border-white/[0.06] bg-black/95 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl gap-1 overflow-x-auto px-5 py-2">
        {days.map((day) => (
          <a
            href={`#day-${day.number}`}
            class="day-tab shrink-0 rounded-lg px-4 py-2 text-sm font-medium text-white/50 transition hover:bg-white/5 hover:text-white"
            data-day={day.number}
          >
            اليوم {day.number}
          </a>
        ))}
        <a
          href="#outcome"
          class="day-tab shrink-0 rounded-lg px-4 py-2 text-sm font-medium text-white/50 transition hover:bg-white/5 hover:text-white"
        >
          النتيجة النهائية
        </a>
      </div>
    </nav>

    <!-- ─── DAYS ──────────────────────────────────────────────── -->
    <main class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
      {days.map((day) => (
        <section id={`day-${day.number}`} class="scroll-mt-32 border-t border-white/[0.06] pt-10 first:border-t-0 first:pt-0 sm:pt-14">
          <div class="mb-8">
            <div class="mb-2 flex flex-wrap items-center gap-3">
              <span class="rounded-md bg-indigo-500 px-2.5 py-1 text-xs font-bold text-white">
                اليوم {day.number}
              </span>
              <span class="text-xs text-white/40">المدة المقترحة: {day.duration}</span>
            </div>
            <h2 class="text-xl leading-snug font-bold sm:text-2xl">{day.title}</h2>
            <div class="mt-4 rounded-lg border border-white/[0.08] bg-white/[0.02] p-4">
              <p class="mb-1 text-xs font-semibold text-white/40">الهدف من اليوم</p>
              <p class="text-sm leading-relaxed text-white/70">{day.goal}</p>
            </div>
          </div>

          <div class="space-y-8">
            {day.sections.map((section) => (
              <div>
                <h3 class="mb-3 text-base font-bold text-white sm:text-lg">{section.title}</h3>

                {section.note && (
                  <p class="mb-2 text-sm text-white/50">{section.note}</p>
                )}

                {section.table && (
                  <div class="mb-2 overflow-x-auto rounded-lg border border-white/[0.08]">
                    <table class="w-full min-w-[420px] border-collapse text-sm">
                      <tbody>
                        {section.table.map((row) => (
                          <tr class="border-b border-white/[0.06] last:border-b-0">
                            <td class="w-32 border-l border-white/[0.06] bg-white/[0.03] p-3 align-top text-sm font-semibold whitespace-nowrap text-indigo-300">
                              {row.group}
                            </td>
                            <td class="p-3 text-sm text-white/70">{row.fields.join("، ")}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {section.flow && (
                  <div class="mb-3 flex flex-wrap items-center gap-2">
                    {section.flow.map((step, i, flowArr) => (
                      <>
                        <span class="rounded-md border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-white/80">
                          {step}
                        </span>
                        {i < flowArr.length - 1 && <span class="text-white/25">←</span>}
                      </>
                    ))}
                  </div>
                )}

                {section.note2 && (
                  <p class="mb-2 text-sm text-white/50">{section.note2}</p>
                )}

                {section.items && section.items.length > 0 && (
                  <ul class="space-y-1.5">
                    {section.items.map((item) => (
                      <li class="flex items-start gap-2.5 text-sm leading-relaxed text-white/70">
                        <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-indigo-400"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>

          <div class="mt-8 rounded-lg border border-indigo-500/20 bg-indigo-500/[0.06] p-4 sm:p-5">
            <p class="mb-1 text-xs font-semibold text-indigo-300">ناتج اليوم {day.number}</p>
            <p class="text-sm leading-relaxed text-white/80">{day.outcome}</p>
          </div>
        </section>
      ))}
    </main>

    <!-- ─── FINAL OUTCOME ─────────────────────────────────────── -->
    <section id="outcome" class="scroll-mt-32 border-t border-white/[0.06] bg-white/[0.02] px-5 py-12 sm:py-16">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-6 text-lg font-bold sm:text-xl">النتيجة النهائية للدورة</h2>
        <p class="mb-6 leading-relaxed text-white/60">
          بنهاية الأيام الأربعة، يكون المشارك قد مر بالرحلة كاملة:
        </p>
        <div class="mb-10 flex flex-wrap items-center gap-2">
          {finalJourney.map((step, i) => (
            <>
              <span class="rounded-md border border-white/10 bg-black/30 px-3 py-1.5 text-sm text-white/80">
                {step}
              </span>
              {i < finalJourney.length - 1 && <span class="text-white/25">↓</span>}
            </>
          ))}
        </div>

        <h3 class="mb-4 text-base font-bold sm:text-lg">المهارات التي سيخرج بها المشارك</h3>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {skills.map((skill) => (
            <div class="flex items-center gap-2 rounded-md border border-white/[0.06] bg-black/30 px-3 py-2">
              <svg class="h-4 w-4 shrink-0 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span class="text-sm text-white/80">{skill}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── TRAINER NOTE ──────────────────────────────────────── -->
    <section class="border-t border-white/[0.06] px-5 py-12 sm:py-16">
      <div class="mx-auto max-w-3xl">
        <div class="rounded-xl border border-amber-500/20 bg-amber-500/[0.05] p-5 sm:p-6">
          <h3 class="mb-3 text-base font-bold text-amber-300 sm:text-lg">ملاحظة مهمة للمدرب</h3>
          <div class="space-y-3 text-sm leading-relaxed text-white/70">
            <p>الدورة ليست دورة برمجة تقليدية.</p>
            <p>
              الهدف ليس أن يتعلم المشارك كتابة كل سطر من الكود يدويًا، وإنما أن يتعلم: كيف
              يستخدم أدوات الذكاء الاصطناعي لبناء تطبيق حقيقي، وكيف يتعامل مع المشاكل التي
              تظهر أثناء البناء، وكيف يأخذ المشروع من مرحلة الفكرة إلى تطبيق قابل للنشر.
            </p>
            <p>
              لذلك يفضل أن يكون معظم الوقت تطبيقًا عمليًا أمام المشاركين، وليس شرحًا نظريًا.
            </p>
          </div>
          <div class="mt-5 border-t border-amber-500/20 pt-4">
            <p class="mb-2 text-xs font-semibold text-amber-300">قاعدة الدورة</p>
            <div class="flex flex-wrap items-center gap-2 text-sm font-medium text-white/80">
              <span class="rounded-md border border-white/10 px-3 py-1.5">اشرح</span>
              <span class="text-white/25">←</span>
              <span class="rounded-md border border-white/10 px-3 py-1.5">طبّق</span>
              <span class="text-white/25">←</span>
              <span class="rounded-md border border-white/10 px-3 py-1.5">اختبر</span>
              <span class="text-white/25">←</span>
              <span class="rounded-md border border-white/10 px-3 py-1.5">أصلح</span>
              <span class="text-white/25">←</span>
              <span class="rounded-md border border-indigo-500/30 bg-indigo-500/10 px-3 py-1.5 text-indigo-300">
                انتقل للخطوة التالية
              </span>
            </div>
          </div>
          <p class="mt-4 text-sm text-white/50">
            وهذا بالضبط ما سيجعل التسجيل لاحقًا مناسبًا كدورة مسجلة مدفوعة بدل أن يكون مجرد
            تسجيل لأربع محاضرات.
          </p>
        </div>
      </div>
    </section>

    <footer class="border-t border-white/[0.06] px-5 py-8 text-center text-sm text-white/30">
      <p>© {new Date().getFullYear()} osama-lab.com — أسامة يحيى عبده رفاعي</p>
    </footer>

    <script>
      const tabs = document.querySelectorAll(".day-tab");
      const sections = Array.from(document.querySelectorAll("main section, section#outcome"));

      const setActive = (id: string) => {
        tabs.forEach((tab) => {
          const isActive = tab.getAttribute("href") === `#${id}`;
          tab.classList.toggle("bg-white/10", isActive);
          tab.classList.toggle("text-white", isActive);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setActive(entry.target.id);
          });
        },
        { rootMargin: "-40% 0px -50% 0px" }
      );

      sections.forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
