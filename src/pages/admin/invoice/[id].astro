---
import "../../../styles/global.css";
import { supabaseAdmin } from "@lib/supabase-admin";
import { getPaymentLang, t } from "@lib/payment-i18n";

const { id } = Astro.params;
const lang = getPaymentLang(Astro.url, Astro.cookies.get("lang")?.value);
const content = t(lang);

const { data: link } = supabaseAdmin
  ? await supabaseAdmin
      .from("payment_links")
      .select(
        "id, title, description, amount, currency, status, client_name, client_phone, payment_gateway, gateway_payment_id, paid_at, created_at"
      )
      .eq("id", id)
      .single()
  : { data: null };

const dateLocale = lang === "ar" ? "ar-SA" : "en-US";
const gatewayLabel: Record<string, string> = {
  moyasar: "Moyasar",
  tamara: "Tamara",
};
---

<!doctype html>
<html lang={lang} dir={content.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{link ? `${content.invoice.title} — ${link.title}` : content.invoice.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme = saved === "dark" || saved === "light" ? saved : "light";
        document.documentElement.classList.add(theme);
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <style>
      @media print {
        .no-print {
          display: none !important;
        }
        html,
        body {
          background: white !important;
        }
        * {
          color: black !important;
          background-color: transparent !important;
          border-color: #cbd5e1 !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-white p-3 font-sans text-slate-900 sm:p-6 md:p-10 dark:bg-black dark:text-white">
    <div class="mx-auto max-w-2xl">
      {!link && (
        <p class="text-red-500 dark:text-red-400">{content.invoice.notFound}</p>
      )}

      {link && (
        <>
          <div class="no-print mb-4 flex justify-end gap-2 sm:mb-6">
            <button
              id="print-btn"
              type="button"
              class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500"
            >
              {content.invoice.print}
            </button>
          </div>

          <div class="rounded-xl border border-slate-200 p-4 sm:p-6 md:p-8 dark:border-white/10">
            <div class="mb-6 flex flex-col gap-4 border-b border-slate-200 pb-6 sm:mb-8 sm:flex-row sm:items-start sm:justify-between dark:border-white/10">
              <div>
                <h1 class="text-xl font-bold sm:text-2xl">{content.invoice.title}</h1>
                <p class="mt-1 text-sm break-all text-slate-500 dark:text-white/50">
                  {content.invoice.invoiceId}: {link.id}
                </p>
              </div>
              <div class="sm:text-right sm:rtl:text-left">
                <p class="font-semibold">أسامة يحيى عبده رفاعي</p>
                <p class="text-sm text-slate-500 dark:text-white/50">FL-150960528</p>
                <p class="text-sm text-slate-500 dark:text-white/50">osama-lab.com</p>
              </div>
            </div>

            <div class="mb-6 grid grid-cols-1 gap-6 sm:mb-8 sm:grid-cols-2">
              <div>
                <p class="mb-1 text-xs font-medium tracking-wide text-slate-400 uppercase dark:text-white/40">
                  {content.invoice.billedTo}
                </p>
                <p class="font-medium">{link.client_name || "—"}</p>
                {link.client_phone && (
                  <p class="text-sm text-slate-500 dark:text-white/50">{link.client_phone}</p>
                )}
              </div>
              <div>
                <p class="mb-1 text-xs font-medium tracking-wide text-slate-400 uppercase dark:text-white/40">
                  {content.invoice.paymentDetails}
                </p>
                <p class="text-sm">
                  {content.invoice.status}:{" "}
                  <span class="font-medium text-green-600 dark:text-green-400">
                    {link.status === "paid" ? content.dashboard.statusPaid : link.status}
                  </span>
                </p>
                {link.payment_gateway && (
                  <p class="text-sm text-slate-500 dark:text-white/50">
                    {content.invoice.method}: {gatewayLabel[link.payment_gateway] ?? link.payment_gateway}
                  </p>
                )}
                {link.gateway_payment_id && (
                  <p class="text-sm break-all text-slate-500 dark:text-white/50">
                    {content.invoice.transactionId}: {link.gateway_payment_id}
                  </p>
                )}
                {link.paid_at && (
                  <p class="text-sm text-slate-500 dark:text-white/50">
                    {content.invoice.paidOn}: {new Date(link.paid_at).toLocaleString(dateLocale)}
                  </p>
                )}
              </div>
            </div>

            <div class="mb-6 overflow-x-auto sm:mb-8">
              <table class="w-full min-w-[280px] border-collapse text-sm">
                <thead>
                  <tr class="border-b border-slate-200 text-left rtl:text-right dark:border-white/10">
                    <th class="pb-2 font-medium text-slate-500 dark:text-white/50">
                      {content.invoice.description}
                    </th>
                    <th class="pb-2 text-right font-medium whitespace-nowrap text-slate-500 rtl:text-left dark:text-white/50">
                      {content.invoice.amount}
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-slate-100 dark:border-white/5">
                    <td class="py-3">
                      <p class="font-medium">{link.title}</p>
                      {link.description && (
                        <p class="text-sm text-slate-500 dark:text-white/50">{link.description}</p>
                      )}
                    </td>
                    <td class="py-3 text-right whitespace-nowrap rtl:text-left">
                      {Number(link.amount).toFixed(2)} {link.currency}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="flex justify-end">
              <div class="w-full max-w-xs">
                <div class="flex items-center justify-between border-t border-slate-200 pt-3 text-base font-bold dark:border-white/10">
                  <span>{content.invoice.total}</span>
                  <span>
                    {Number(link.amount).toFixed(2)} {link.currency}
                  </span>
                </div>
              </div>
            </div>

            <p class="mt-8 text-xs text-slate-400 dark:text-white/40">
              {content.invoice.createdOn}: {new Date(link.created_at).toLocaleString(dateLocale)}
            </p>
          </div>
        </>
      )}
    </div>

    <script>
      document.getElementById("print-btn")?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>
