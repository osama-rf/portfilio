---
import AdminLayout from "@layouts/AdminLayout.astro";
import { supabaseAdmin } from "@lib/supabase-admin";
import { getAppUrl } from "@lib/site-url";
import { getPaymentLang, t } from "@lib/payment-i18n";

const lang = getPaymentLang(Astro.url, Astro.cookies.get("lang")?.value);
const content = t(lang);

const { data: links, error } = supabaseAdmin
  ? await supabaseAdmin
      .from("payment_links")
      .select("id, title, amount, currency, status, moyasar_enabled, tamara_enabled, client_name, client_phone, created_at")
      .order("created_at", { ascending: false })
  : { data: [], error: null };

const appUrl = getAppUrl();

const statusLabel: Record<string, string> = {
  pending: content.dashboard.statusPending,
  paid: content.dashboard.statusPaid,
  expired: content.dashboard.statusExpired,
  cancelled: content.dashboard.statusCancelled,
};

const statusColor: Record<string, string> = {
  pending: "text-yellow-600 dark:text-yellow-400",
  paid: "text-green-600 dark:text-green-400",
  expired: "text-slate-400 dark:text-white/40",
  cancelled: "text-red-600 dark:text-red-400",
};

const dateLocale = lang === "ar" ? "ar-SA" : "en-US";
---

<AdminLayout title={content.dashboard.title}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-xl font-semibold sm:text-2xl">{content.dashboard.title}</h1>
    <a
      href={`/admin/new?lang=${lang}`}
      class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500"
    >
      {content.dashboard.newLink}
    </a>
  </div>

  {error && (
    <p class="text-red-500 dark:text-red-400">
      {content.dashboard.loadError}: {error.message}
    </p>
  )}

  {!links?.length && !error && (
    <p class="text-slate-500 dark:text-white/50">{content.dashboard.empty}</p>
  )}

  <div class="space-y-3">
    {links?.map((link) => (
      <div class="link-card rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-white/10 dark:bg-white/5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-medium break-words">{link.title}</p>
            <div class="view-mode">
              {link.client_name && (
                <p class="text-sm text-slate-500 dark:text-white/50">
                  {link.client_name}
                  {link.client_phone && ` · ${link.client_phone}`}
                </p>
              )}
              {!link.client_name && link.client_phone && (
                <p class="text-sm text-slate-500 dark:text-white/50">{link.client_phone}</p>
              )}
              {!link.client_name && !link.client_phone && (
                <p class="text-sm text-slate-400 italic dark:text-white/30">
                  {content.newLink.clientName}: —
                </p>
              )}
            </div>
            <form class="edit-form hidden mt-2 flex flex-wrap items-center gap-2" data-id={link.id}>
              <input
                type="text"
                class="edit-name w-40 rounded border border-slate-200 bg-white px-2 py-1 text-sm dark:border-white/10 dark:bg-black/30"
                placeholder={content.newLink.clientName}
                value={link.client_name ?? ""}
              />
              <input
                type="tel"
                class="edit-phone w-32 rounded border border-slate-200 bg-white px-2 py-1 text-sm dark:border-white/10 dark:bg-black/30"
                placeholder={content.newLink.clientPhone}
                value={link.client_phone ?? ""}
              />
              <button
                type="submit"
                class="rounded bg-indigo-600 px-2 py-1 text-xs text-white hover:bg-indigo-500"
              >
                {content.dashboard.save}
              </button>
              <button type="button" class="cancel-edit-btn rounded bg-slate-200 px-2 py-1 text-xs dark:bg-white/10">
                {content.dashboard.cancel}
              </button>
              <p class="edit-error hidden w-full text-xs text-red-500 dark:text-red-400"></p>
            </form>
            <button
              type="button"
              class="edit-btn view-mode mt-1 text-xs text-indigo-600 hover:underline dark:text-indigo-400"
            >
              {content.dashboard.editClient}
            </button>
            <p class="mt-1 text-sm text-slate-400 dark:text-white/40">
              {new Date(link.created_at).toLocaleString(dateLocale)}
            </p>
          </div>
          <div class="text-right rtl:text-left">
            <p class="font-semibold">
              {Number(link.amount).toFixed(2)} {link.currency}
            </p>
            <p class={`text-sm ${statusColor[link.status] ?? "text-slate-500 dark:text-white/60"}`}>
              {statusLabel[link.status] ?? link.status}
            </p>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-400 dark:text-white/40">
          {link.moyasar_enabled && (
            <span class="rounded bg-slate-200 px-2 py-1 dark:bg-white/10">Moyasar</span>
          )}
          {link.tamara_enabled && (
            <span class="rounded bg-slate-200 px-2 py-1 dark:bg-white/10">Tamara</span>
          )}
        </div>
        <div class="mt-3 flex items-center gap-2">
          <input
            readonly
            value={`${appUrl}/pay/${link.id}`}
            class="copy-input w-full min-w-0 rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-600 dark:border-white/10 dark:bg-black/30 dark:text-white/70"
          />
          <button
            type="button"
            class="copy-btn shrink-0 rounded bg-slate-200 px-3 py-1 text-xs hover:bg-slate-300 dark:bg-white/10 dark:hover:bg-white/20"
            data-url={`${appUrl}/pay/${link.id}`}
            data-copied={content.dashboard.copied}
          >
            {content.dashboard.copy}
          </button>
          {link.status === "paid" && (
            <a
              href={`/admin/invoice/${link.id}?lang=${lang}`}
              target="_blank"
              class="shrink-0 rounded bg-slate-200 px-3 py-1 text-xs hover:bg-slate-300 dark:bg-white/10 dark:hover:bg-white/20"
            >
              {content.invoice.viewInvoice}
            </a>
          )}
          <button
            type="button"
            class="delete-btn shrink-0 rounded bg-red-100 px-3 py-1 text-xs text-red-700 hover:bg-red-200 dark:bg-red-500/10 dark:text-red-400 dark:hover:bg-red-500/20"
            data-id={link.id}
          >
            {content.dashboard.delete}
          </button>
        </div>
      </div>
    ))}
  </div>

  <script
    define:vars={{
      deleteConfirmMsg: content.dashboard.deleteConfirm,
      deleteFailedMsg: content.dashboard.deleteFailed,
      updateFailedMsg: content.dashboard.updateFailed,
    }}
  >
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.getAttribute("data-url");
        if (!url) return;
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        const copiedLabel = btn.getAttribute("data-copied") || "Copied!";
        btn.textContent = copiedLabel;
        setTimeout(() => (btn.textContent = original), 1500);
      });
    });

    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id");
        if (!id) return;
        if (!confirm(deleteConfirmMsg)) return;

        const res = await fetch(`/api/admin/payment-links/${id}`, { method: "DELETE" });
        if (res.ok) {
          window.location.reload();
        } else {
          alert(deleteFailedMsg);
        }
      });
    });

    document.querySelectorAll(".link-card").forEach((card) => {
      const editBtn = card.querySelector(".edit-btn");
      const editForm = card.querySelector(".edit-form");
      const cancelBtn = card.querySelector(".cancel-edit-btn");
      const viewModeEls = card.querySelectorAll(".view-mode");
      const errorEl = card.querySelector(".edit-error");

      const toggle = (showEdit) => {
        editForm.classList.toggle("hidden", !showEdit);
        viewModeEls.forEach((el) => el.classList.toggle("hidden", showEdit));
      };

      editBtn?.addEventListener("click", () => toggle(true));
      cancelBtn?.addEventListener("click", () => toggle(false));

      editForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.add("hidden");

        const id = editForm.getAttribute("data-id");
        const client_name = editForm.querySelector(".edit-name").value.trim();
        const client_phone = editForm.querySelector(".edit-phone").value.trim();

        const res = await fetch(`/api/admin/payment-links/${id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ client_name, client_phone: client_phone || null }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json().catch(() => ({}));
          errorEl.textContent = data.error || updateFailedMsg;
          errorEl.classList.remove("hidden");
        }
      });
    });
  </script>
</AdminLayout>
