---
import AdminLayout from "@layouts/AdminLayout.astro";
import { getPaymentLang, t } from "@lib/payment-i18n";

const lang = getPaymentLang(Astro.url, Astro.cookies.get("lang")?.value);
const content = t(lang);
---

<AdminLayout title={content.newLink.title}>
  <h1 class="mb-6 text-xl font-semibold sm:text-2xl">{content.newLink.title}</h1>

  <form id="new-form" class="max-w-lg space-y-4">
    <div>
      <label class="mb-1 block text-sm text-slate-500 dark:text-white/60" for="title">
        {content.newLink.titleField}
      </label>
      <input
        id="title"
        name="title"
        type="text"
        required
        placeholder={content.newLink.titlePlaceholder}
        class="w-full rounded-md border border-slate-200 bg-white px-3 py-2 outline-none focus:border-indigo-500 dark:border-white/10 dark:bg-white/5 dark:text-white"
      />
    </div>

    <div>
      <label class="mb-1 block text-sm text-slate-500 dark:text-white/60" for="description">
        {content.newLink.description}
      </label>
      <textarea
        id="description"
        name="description"
        rows="3"
        class="w-full rounded-md border border-slate-200 bg-white px-3 py-2 outline-none focus:border-indigo-500 dark:border-white/10 dark:bg-white/5 dark:text-white"
      ></textarea>
    </div>

    <div>
      <label class="mb-1 block text-sm text-slate-500 dark:text-white/60" for="client_name">
        {content.newLink.clientName}
      </label>
      <input
        id="client_name"
        name="client_name"
        type="text"
        class="w-full rounded-md border border-slate-200 bg-white px-3 py-2 outline-none focus:border-indigo-500 dark:border-white/10 dark:bg-white/5 dark:text-white"
      />
    </div>

    <div>
      <label class="mb-1 block text-sm text-slate-500 dark:text-white/60" for="client_phone">
        {content.newLink.clientPhone}
      </label>
      <input
        id="client_phone"
        name="client_phone"
        type="tel"
        placeholder="05XXXXXXXX"
        class="w-full rounded-md border border-slate-200 bg-white px-3 py-2 outline-none focus:border-indigo-500 dark:border-white/10 dark:bg-white/5 dark:text-white"
      />
      <p class="mt-1 text-xs text-slate-400 dark:text-white/40">{content.newLink.clientPhoneHint}</p>
    </div>

    <div class="flex gap-4">
      <div class="flex-1">
        <label class="mb-1 block text-sm text-slate-500 dark:text-white/60" for="amount">
          {content.newLink.amount}
        </label>
        <input
          id="amount"
          name="amount"
          type="number"
          step="0.01"
          min="1"
          required
          class="w-full rounded-md border border-slate-200 bg-white px-3 py-2 outline-none focus:border-indigo-500 dark:border-white/10 dark:bg-white/5 dark:text-white"
        />
      </div>
      <div class="w-24 sm:w-28">
        <label class="mb-1 block text-sm text-slate-500 dark:text-white/60" for="currency">
          {content.newLink.currency}
        </label>
        <input
          id="currency"
          name="currency"
          type="text"
          value="SAR"
          required
          class="w-full rounded-md border border-slate-200 bg-white px-3 py-2 outline-none focus:border-indigo-500 dark:border-white/10 dark:bg-white/5 dark:text-white"
        />
      </div>
    </div>

    <div>
      <p class="mb-2 text-sm text-slate-500 dark:text-white/60">{content.newLink.methods}</p>
      <label class="mb-2 flex items-center gap-2">
        <input id="moyasar_enabled" type="checkbox" checked class="h-4 w-4" />
        <span>{content.newLink.moyasar}</span>
      </label>
      <label class="flex items-center gap-2">
        <input id="tamara_enabled" type="checkbox" class="h-4 w-4" />
        <span>{content.newLink.tamara}</span>
      </label>
    </div>

    <p id="form-error" class="hidden text-sm text-red-500 dark:text-red-400"></p>

    <button
      type="submit"
      class="rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500"
    >
      {content.newLink.create}
    </button>
  </form>

  <div
    id="success-box"
    class="mt-6 hidden max-w-lg rounded-lg border border-green-500/30 bg-green-50 p-4 dark:bg-green-500/10"
  >
    <p class="mb-2 font-medium text-green-700 dark:text-green-400">{content.newLink.created}</p>
    <div class="flex items-center gap-2">
      <input
        id="result-url"
        readonly
        class="w-full min-w-0 rounded border border-slate-200 bg-white px-2 py-1 text-sm dark:border-white/10 dark:bg-black/30"
      />
      <button
        id="result-copy"
        type="button"
        class="shrink-0 rounded bg-slate-200 px-3 py-1 text-sm hover:bg-slate-300 dark:bg-white/10 dark:hover:bg-white/20"
      >
        {content.dashboard.copy}
      </button>
    </div>
    <a
      href={`/admin?lang=${lang}`}
      class="mt-3 inline-block text-sm text-slate-500 hover:text-slate-900 dark:text-white/60 dark:hover:text-white"
    >
      {content.newLink.backToDashboard}
    </a>
  </div>

  <script
    define:vars={{
      needMethodMsg: content.newLink.needMethod,
      createFailedMsg: content.newLink.createFailed,
      needPhoneMsg: content.newLink.needPhone,
    }}
  >
    const form = document.getElementById("new-form");
    const errorEl = document.getElementById("form-error");
    const successBox = document.getElementById("success-box");
    const resultUrl = document.getElementById("result-url");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.classList.add("hidden");

      const payload = {
        title: document.getElementById("title").value,
        description: document.getElementById("description").value || null,
        client_name: document.getElementById("client_name").value || null,
        client_phone: document.getElementById("client_phone").value || null,
        amount: parseFloat(document.getElementById("amount").value),
        currency: document.getElementById("currency").value.toUpperCase(),
        moyasar_enabled: document.getElementById("moyasar_enabled").checked,
        tamara_enabled: document.getElementById("tamara_enabled").checked,
      };

      if (!payload.moyasar_enabled && !payload.tamara_enabled) {
        errorEl.textContent = needMethodMsg;
        errorEl.classList.remove("hidden");
        return;
      }

      if (payload.tamara_enabled && !payload.client_phone) {
        errorEl.textContent = needPhoneMsg;
        errorEl.classList.remove("hidden");
        return;
      }

      const res = await fetch("/api/admin/payment-links", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        errorEl.textContent = data.error || createFailedMsg;
        errorEl.classList.remove("hidden");
        return;
      }

      form.classList.add("hidden");
      resultUrl.value = data.url;
      successBox.classList.remove("hidden");
    });

    document.getElementById("result-copy")?.addEventListener("click", async () => {
      await navigator.clipboard.writeText(resultUrl.value);
    });
  </script>
</AdminLayout>
